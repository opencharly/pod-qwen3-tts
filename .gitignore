.build/
*.log
__pycache__/
*.pyc
.pixi/

# Generated context-ignore files (podman reads .containerignore, docker .dockerignore)
.containerignore
.dockerignore
# Eval run scratch
.check/
# VM / disk-image build outputs
output/
# VM build scratch (charly vm build writes <state>/image/<vm>/.build.lock)
image/
# Editor scratch
*.swp
*~

# Migration rollback backups (charly migrate writes <file>.bak.<unix-ts>)
*.bak
*.bak.*

# Syncthing conflict copies — per-machine, ephemeral, resolved by hand; never versioned.
*.sync-conflict-*
